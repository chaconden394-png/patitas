# Copia este archivo como .env y llena los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Clave secreta para las sesiones de Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# development o production
PATITAS_ENV=development

# --- Supabase ---------------------------------------------------------------
# Si dejas estas dos líneas vacías, la app funciona en "modo de ejemplo".
#
# URL del proyecto: algo como https://abcdefghijk.supabase.co
SUPABASE_URL=
# Clave PÚBLICA. En el panel de Supabase puede llamarse "publishable"
# (empieza con sb_publishable_) o "anon" (formato antiguo, empieza con eyJ).
# NUNCA pongas aquí la clave "secret" / "service_role".
SUPABASE_CLAVE_PUBLICA=
